{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acme.com.mx/schemas/page_assets/v1",
  "version": "1.0.0",
  "title": "page_assets",
  "description": "Memory block written by Agent 4.3 (Web + Landing Pages). Production-ready landing pages for a campaign: ordered sections + client-facing copy, the conversion form + primary CTA, SEO/technical scaffolding, and A/B test variants. Read by Layer 5 (5.1 Campaign Launcher points traffic at these pages; 5.3 Lead Capture wires the form to the CRM) and Layer 6 (6.1 measures the variants; 6.3 picks winners). Reads: campaign_registry, audience_segments, copy_assets; optional client_profile. Human gate: full review. First authored: 2026-05-29",
  "type": "object",
  "required": [
    "client_id",
    "created_at",
    "gate_status",
    "campaign_ref",
    "pages",
    "summary"
  ],
  "additionalProperties": true,
  "definitions": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "hero",
            "social_proof",
            "problem",
            "value_prop",
            "benefits",
            "features",
            "how_it_works",
            "testimonials",
            "faq",
            "pricing",
            "lead_magnet",
            "final_cta"
          ]
        },
        "headline": {
          "type": [
            "string",
            "null"
          ],
          "description": "Client-facing section headline, ES-MX (or client primary language)."
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "Client-facing section copy, ES-MX (or client primary language)."
        },
        "cta": {
          "type": [
            "string",
            "null"
          ],
          "description": "Client-facing CTA label for conversion sections, ES-MX; null otherwise."
        },
        "source_copy_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of the reused copy_assets entry, or null when this section's copy is newly authored by 4.3."
        },
        "notes_for_designer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional EN guidance for the front-end / Agent 4.2 (layout, imagery, alt text)."
        }
      }
    },
    "form_field": {
      "type": "object",
      "required": [
        "name",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Client-facing field label, ES-MX."
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "email",
            "tel",
            "select",
            "textarea",
            "checkbox",
            "number",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Options for select fields (ES-MX)."
        }
      }
    },
    "cta_spec": {
      "type": "object",
      "required": [
        "label",
        "action"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Client-facing CTA label, ES-MX."
        },
        "action": {
          "type": "string",
          "enum": [
            "submit_form",
            "book_call",
            "whatsapp",
            "external_url",
            "scroll_to_form",
            "download"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "description": "Route, calendar link, WhatsApp deep link, or external URL."
        }
      }
    },
    "form": {
      "type": "object",
      "required": [
        "fields",
        "primary_cta"
      ],
      "additionalProperties": true,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/form_field"
          },
          "minItems": 1
        },
        "primary_cta": {
          "$ref": "#/definitions/cta_spec"
        },
        "secondary_cta": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/cta_spec"
            }
          ]
        },
        "trust_elements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short trust signals shown near the form, ES-MX."
        }
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "slug",
        "meta_title",
        "meta_description"
      ],
      "additionalProperties": true,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Lowercase-hyphenated ASCII slug."
        },
        "meta_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "meta_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "og_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "og_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_keyword": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tech": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recommended_route": {
          "type": "string"
        },
        "mobile_first": {
          "type": "boolean"
        },
        "analytics_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_budget_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ab_test": {
      "type": "object",
      "required": [
        "test_id",
        "hypothesis",
        "element",
        "variant_a",
        "variant_b",
        "primary_metric"
      ],
      "additionalProperties": true,
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "description": "EN — what the test believes and why."
        },
        "element": {
          "type": "string",
          "enum": [
            "hero_headline",
            "primary_cta_label",
            "hero_layout",
            "form_length",
            "social_proof_placement",
            "offer_framing",
            "subhead",
            "hero_image"
          ]
        },
        "variant_a": {
          "type": "string",
          "minLength": 1,
          "description": "The control — what the base page uses (ES-MX where copy)."
        },
        "variant_b": {
          "type": "string",
          "minLength": 1,
          "description": "The challenger — the alternative (ES-MX where copy)."
        },
        "primary_metric": {
          "type": "string",
          "enum": [
            "form_submit_rate",
            "cta_click_rate",
            "bounce_rate",
            "demo_book_rate",
            "scroll_depth",
            "time_on_page"
          ]
        },
        "min_sample_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "EN — when the test can be called."
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "page_id",
        "page_name",
        "campaign_id",
        "goal",
        "sections",
        "form",
        "seo"
      ],
      "additionalProperties": true,
      "properties": {
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "page_name": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "target_segment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "type": "string",
          "enum": [
            "lead_capture",
            "demo_booking",
            "event_registration",
            "sale",
            "webinar",
            "content_download",
            "waitlist"
          ]
        },
        "funnel_stage": {
          "type": "string",
          "enum": [
            "awareness",
            "consideration",
            "conversion",
            "retention"
          ]
        },
        "language": {
          "type": "string",
          "description": "BCP-47-ish primary language tag for the page copy, e.g. es-MX."
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/section"
          },
          "minItems": 1
        },
        "form": {
          "$ref": "#/definitions/form"
        },
        "seo": {
          "$ref": "#/definitions/seo"
        },
        "tech": {
          "$ref": "#/definitions/tech"
        },
        "ab_tests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ab_test"
          }
        },
        "build_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Client identifier. Format: lowercase-hyphenated."
    },
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when this page_assets block was generated."
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "returned",
        "blocked",
        "auto_approved"
      ],
      "default": "pending_review",
      "description": "Full-review gate status. Must be 'approved' before Agent 5.1 points traffic at the page."
    },
    "campaign_ref": {
      "type": "string",
      "minLength": 1,
      "description": "campaign_id (from campaign_registry) this page set serves."
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/page"
      },
      "description": "The landing pages built this run. May be empty only when gate_status is 'blocked'."
    },
    "summary": {
      "type": "object",
      "required": [
        "total_pages",
        "total_sections"
      ],
      "additionalProperties": true,
      "properties": {
        "total_pages": {
          "type": "integer",
          "minimum": 0
        },
        "total_sections": {
          "type": "integer",
          "minimum": 0
        },
        "total_variants": {
          "type": "integer",
          "minimum": 0
        },
        "pages_by_goal": {
          "type": "object"
        },
        "reused_copy_refs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "build_notes": {
      "type": "string",
      "description": "EN — assumptions, missing inputs, coherence flags, blocked reasons."
    }
  }
}
